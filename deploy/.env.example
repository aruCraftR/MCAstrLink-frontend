# ===== 构建时环境变量(打包前设置, 值会被内联进产物) =====
# API地址: 同源模式填 /mcastrlink; 非同源模式填完整URL(如 https://panel-api.arucraftr.org)
NUXT_PUBLIC_API_BASE=/mcastrlink
# 同源模式下Nuxt服务端代理转发的后端真实地址
NUXT_API_PROXY_TARGET=http://127.0.0.1:22565
# 页面显示的应用名
NUXT_PUBLIC_APP_NAME=MCAstrLink

# ===== 运行时环境变量(启动时设置, 由启动脚本读取) =====
# 监听地址与端口
HOST=0.0.0.0
PORT=3000
